#!/bin/bash
# info: change dns domain ttl
# options: USER DOMAIN TTL [RESTART] [BULK UPDATE]
#
# example: v-change-dns-domain-ttl alice example.com 14400
#
# This function for changing the time to live TTL parameter for all records.
#
# When more then 99 changes are made in a single day the SERIAL of BIND will overflow
# the 10 characters to 11 character string causing issues with BIND / DNS service
# In case of a mass update set BULK UPDATE  to yes to disable increment of SERIAL
# Last update to make set  BULK UPDATE  to no and make the last change


#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
domain=$2
domain_idn=$2
ttl=$3
restart=$4
bulk=${5-no}

# Includes
# shellcheck source=/etc/hestiacp/hestia.conf
source /etc/hestiacp/hestia.conf
# shellcheck source=/usr/local/hestia/func/main.sh
source $HESTIA/func/main.sh
# shellcheck source=/usr/local/hestia/func/domain.sh
source $HESTIA/func/domain.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

# Additional argument formatting
format_domain
format_domain_idn
# TODO: $domain_idn not used in this script - maybe $domain should be converted to $doman_idn ?

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '3' "$#" 'USER DOMAIN TTL [RESTART] [BULK UPDATE]'
is_format_valid 'user' 'domain' 'ttl'
is_system_enabled "$DNS_SYSTEM" 'DNS_SYSTEM'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"
is_object_valid 'dns' 'DOMAIN' "$domain"
is_object_unsuspended 'dns' 'DOMAIN' "$domain"
is_able_increment_serial "$user" "$domain"

# Perform verification if read-only mode is enabled
check_hestia_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Changing ttl
update_object_value 'dns' 'DOMAIN' "$domain" '$TTL' "$ttl"

# Updating zone
if [ "$bulk" != "yes" ]; then
    # Updating zone
    if [[ "$DNS_SYSTEM" =~ named|bind ]]; then
        update_domain_serial
        update_domain_zone
    fi
    
    # Updating dns-cluster queue
    if [ -n "$DNS_CLUSTER" ]; then
        # Check for first sync
        dlock=$(grep "domain $user $domain" $HESTIA/data/queue/dns-cluster.pipe)
        if [ -z "$dlock" ]; then
            cmd="$BIN/v-change-remote-dns-domain-ttl $user $domain $ttl"
            echo "$cmd" >> $HESTIA/data/queue/dns-cluster.pipe
        fi
    fi
fi

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

# Restarting named
$BIN/v-restart-dns "$restart"
check_result $? "DNS restart failed" >/dev/null

# Logging
$BIN/v-log-action "$user" "Info" "DNS" "TTL for DNS domain changed (TTL: $ttl, Domain: $domain)."
log_event "$OK" "$ARGUMENTS"

exit
